# Copy this file to .env in the same directory and fill in real values.
# .env is gitignored - never commit real credentials.

POSTGRES_USER=erdms_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=erdms_metadata

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=erdms-documents

# Optional: enable IMAP-based email attachment ingestion
EMAIL_MONITORING_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=993
EMAIL_USER=
EMAIL_PASS=
